# Copy to .env, fill in, then:  source .env
# .env is gitignored; .env.example is committed. All absolute paths live here
# so the code stays portable across machines (local box, RunPod, cluster).

# ---- Root paths -----------------------------------------------------------
export REPO_PATH=/abs/path/to/ToolOrchestra          # this repo
export HF_HOME=/abs/path/to/hf_cache                 # HF models + corpus cache (size it big)
export INDEX_DIR=/abs/path/to/index                  # retrieval faiss index + corpus (multi-train/index)
export CKPT_DIR=/abs/path/to/Nemotron-Orchestrator-8B  # orchestrator checkpoint
export KEYS_DIR=$REPO_PATH/keys                      # OAuth token cache (optional; defaults here)

# ---- API keys / credentials ----------------------------------------------
export OPENROUTER_API_KEY=  # https://openrouter.ai/keys — routes gpt-5/qwen/llama/claude
# Optional OpenRouter overrides:
# export OPENROUTER_REASONING_EFFORT=high        # for gpt-5 / o3 family
# export OPENROUTER_CLAUDE_OPUS=anthropic/claude-opus-4
# export OPENROUTER_CLAUDE_SONNET=anthropic/claude-sonnet-4
export TAVILY_KEY=          # https://app.tavily.com/home
export WANDB_API_KEY=       # training only
export OSS_KEY=             # NVIDIA NGC (integrate.api.nvidia.com — hosts Qwen/Nemotron tools)
export CLIENT_ID=           # NVIDIA internal OAuth (gpt-5 / Claude routes in LLM_CALL.py)
export CLIENT_SECRET=
# If you repoint LLM_CALL.py to public providers, add their keys too:
# export OPENAI_API_KEY=
# export ANTHROPIC_API_KEY=
